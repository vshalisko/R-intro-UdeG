graph TD
    %% Título principal
    CALCULO["Cálculo Diferencial de una Variable<br/><i>(Programa de Asignatura)</i>"]

    %% Bloque 1: Origen y Variación
    subgraph M1 ["1. Tasas de Cambio y Variación"]
        A["Tasa de Cambio Promedio<br/><b>Δy / Δx = [f(x₂)-f(x₁)] / [x₂-x₁]</b>"] --> B["Secante a Tangente<br/><b>Pendiente mₛₑ꜀ → mₜₐₙ</b>"]
        B --> C["Tasa de Cambio Instantánea<br/><b>lim (Δx→0) Δy/Δx</b>"]
    end

    %% Bloque 2: Límites y Continuidad
    subgraph M2 ["2. Fundamentos de Límites y Continuidad"]
        D["Concepto de Límite<br/><b>lim (x→c) f(x) = L</b>"] --> E["Límites Laterales y Existencia<br/><b>lim (x→c⁻) = lim (x→c⁺)</b>"]
        E --> F["Indeterminaciones y Continuidad<br/><b>Formas 0/0, ∞/∞ y Saltos</b>"]
    end

    %% Bloque 3: Definición de la Derivada
    subgraph M3 ["3. Definición Operativa de la Derivada"]
        G["Cociente Diferencial<br/><b>f'(x) = lim (h→0) [f(x+h)-f(x)]/h</b>"] --> H["Interpretación Geométrica<br/><b>Pendiente de la Recta Tangente</b>"]
        H --> I["Diferenciabilidad y Suavidad<br/><b>f'(x) existe ⟹ f es continua</b>"]
    end

    %% Bloque 4: Reglas Operativas y Orden Superior
    subgraph M4 ["4. Reglas Operativas y Orden Superior"]
        J["Reglas Básicas y Cadenas<br/><b>(xⁿ)', (u·v)', (u/v)', (f ∘ g)'</b>"] --> K["Funciones Trascendentes<br/><b>(sin x)' = cos x  |  (eˣ)' = eˣ</b>"]
        K --> L["Derivadas de Orden Superior<br/><b>f''(x), f'''(x), ..., f⁽ⁿ⁾(x)</b>"]
    end

    %% Rama A: Derivación Implícita
    subgraph M5 ["5. Derivación Implícita y Tasas Relacionadas"]
        M["Derivación Implícita<br/><b>d/dx[F(x,y) = 0] ⟹ dy/dx</b>"] --> N["Tasas de Cambio Relacionadas<br/><b>Relación dy/dt con dx/dt</b>"]
    end

    %% Rama B: Análisis Gráfico de Funciones
    subgraph M6 ["6. Análisis Gráfico de Funciones"]
        O["Criterio de la 1ª Derivada<br/><b>Monotonía y Extremos Relativos f'(c)=0</b>"] --> P["Criterio de la 2ª Derivada<br/><b>Concavidad y Puntos de Inflexión f''(c)=0</b>"]
        P --> Q["Teoremas del Valor Medio y Rolle<br/><b>f'(c) = [f(b)-f(a)] / (b-a)</b>"]
    end

    %% Rama C: Métodos de Aproximación y Numéricos
    subgraph M7 ["7. Métodos de Aproximación y Numéricos"]
        R["Aproximación Lineal y Diferenciales<br/><b>L(x) = f(a) + f'(a)(x-a)  |  dy = f'(x)dx</b>"] --> S["Método de Newton-Raphson<br/><b>xₙ₊₁ = xₙ - f(xₙ) / f'(xₙ)</b>"]
    end

    %% Bloque 8: Optimización Aplicada
    subgraph M8 ["8. Optimización Aplicada"]
        T["Problemas de Máximos y Mínimos<br/><b>Modelación con Restricciones Reales</b>"]
    end

    %% Secuencia jerárquica principal
    CALCULO --> M1
    M1 --> M2
    M2 --> M3
    M3 --> M4
    
    %% Ramificación didáctica desde el bloque 4
    M4 --> M5
    M4 --> M6
    M4 --> M7

    %% Integración hacia la aplicación final
    M6 & M7 --> M8
