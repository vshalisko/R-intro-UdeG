flowchart TD
%% Definición de estilos
classDef inicioFin fill:#2b5876,stroke:#1a3648,stroke-width:2px,color:#ffffff,font-weight:bold
classDef entrada fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#78350f
classDef proceso fill:#f4f7f6,stroke:#4e7a8c,stroke-width:2px,color:#1f2933
classDef modelo fill:#e8f4f8,stroke:#0077b6,stroke-width:2px,color:#03045e
classDef eval fill:#f3e8ff,stroke:#7e22ce,stroke-width:2px,color:#3b0764

Inicio([Inicio del Análisis: Modelo GAM]):::inicioFin --> Config

subgraph S1 [1. Configuración y Entradas Independientes]
direction TB
Config["Preparar entorno de trabajo



Cargar librerías y verificar sesión



library(sf, foreign, raster, mgcv, RColorBrewer)



sessionInfo()"]:::proceso

InTabla[/"<b>Tabla de datos DBF</b><br/>Leer temperaturas<br/><code>temp <- read.dbf('datos/Temp.dbf')</code>"/]:::entrada
InVector[/"<b>Datos Vectoriales SHP</b><br/>Leer estaciones meteorológicas<br/><code>estaciones <- st_read('datos/Estaciones_SMN_alt_ok.shp')</code>"/]:::entrada
InRaster[/"<b>Datos Raster GeoTIFF</b><br/>Leer Modelo Digital de Elevación<br/><code>mde <- raster('datos/MDE_occidente_500m_float_GEO.tif')</code>"/]:::entrada

Config --> InTabla
Config --> InVector
Config --> InRaster


end

subgraph S2 [2. Preprocesamiento y Exploración]
direction TB
P_Merge["2.1 Unión tabular-espacial



Combinar estaciones y temperaturas por ID



estaciones_temp <- merge(estaciones, temp, by='NUMERO_DE_')"]:::proceso

P_Filter["<b>2.2 Filtrado de registros</b><br/>Eliminar estaciones con temperatura cero<br/><code>filtro <- estaciones_temp$TNOV == 0</code><br/><code>estaciones_temp <- estaciones_temp[!filtro,]</code>"]:::proceso

P_Coords["<b>2.3 Extracción de coordenadas</b><br/>Obtener latitud y longitud explícitas<br/><code>estaciones_temp$LAT <- st_coordinates(estaciones_temp)[,'Y']</code><br/><code>estaciones_temp$LON <- st_coordinates(estaciones_temp)[,'X']</code>"]:::proceso

P_Explore["<b>2.4 Exploración geoespacial</b><br/>Mapear patrones de temperatura y elevación<br/><code>plot(estaciones_temp[,'TNOV'])</code><br/><code>plot(estaciones_temp[,'Z_FIN'])</code>"]:::proceso

InTabla --> P_Merge
InVector --> P_Merge
P_Merge --> P_Filter
P_Filter --> P_Coords
P_Coords --> P_Explore


end

