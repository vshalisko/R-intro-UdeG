flowchart TD
%% Definición de estilos
classDef inicioFin fill:#2b5876,stroke:#1a3648,stroke-width:2px,color:#ffffff,font-weight:bold
classDef proceso fill:#f4f7f6,stroke:#4e7a8c,stroke-width:2px,color:#1f2933
classDef modelo fill:#e8f4f8,stroke:#0077b6,stroke-width:2px,color:#03045e
classDef subgrafo fill:#ffffff,stroke:#cbd5e1,stroke-width:1px,stroke-dasharray: 5 5

Inicio([Inicio del Análisis: Modelo GAM]):::inicioFin --> Paso1

subgraph S1 [1. Configuración y Carga de Datos]
    direction TB
    Paso1["<b>Preparar entorno de trabajo</b><br/>Cargar librerías espaciales y de modelado<br/><code>library(sf, foreign, raster, mgcv, RColorBrewer)</code><br/><code>sessionInfo()</code>"]:::proceso
    
    Paso2["<b>Leer archivos de datos</b><br/>Importar tablas DBF, capas vectoriales y raster MDE<br/><code>temp <- read.dbf('datos/Temp.dbf')</code><br/><code>estaciones <- st_read('datos/Estaciones_SMN_alt_ok.shp')</code><br/><code>mde <- raster('datos/MDE_occidente_500m_float_GEO.tif')</code>"]:::proceso
    
    Paso1 --> Paso2
end

subgraph S2 [2. Preprocesamiento y Exploración]
    direction TB
    Paso3["<b>Unir y limpiar datos espaciales</b><br/>Combinar tablas por ID, filtrar ceros y extraer coordenadas<br/><code>estaciones_temp <- merge(estaciones, temp, by='NUMERO_DE_')</code><br/><code>estaciones_temp <- estaciones_temp[estaciones_temp$TNOV != 0,]</code><br/><code>estaciones_temp$LAT <- st_coordinates(estaciones_temp)[,'Y']</code><br/><code>estaciones_temp$LON <- st_coordinates(estaciones_temp)[,'X']</code>"]:::proceso

    Paso4["<b>Explorar patrón geoespacial</b><br/>Visualizar distribución espacial de temperatura y altitud<br/><code>plot(estaciones_temp[,'TNOV'])</code><br/><code>plot(estaciones_temp[,'Z_FIN'])</code>"]:::proceso

    Paso2 --> Paso3
    Paso3 --> Paso4
end

subgraph S3 [3. Modelado Aditivo Generalizado GAM]
    direction LR
    Paso5["<b>Modelo GAM Univariado modelo8</b><br/>Ajustar temperatura en función de la altitud<br/><code>modelo8 <- gam(TNOV ~ s(Z_FIN), data = estaciones_temp)</code><br/><code>summary(modelo8)</code><br/><code>gam.check(modelo8)</code><br/><code>plot(modelo8, pages = 1, residuals = TRUE)</code>"]:::modelo

    Paso6["<b>Modelo GAM Multivariado modelo9</b><br/>Incluir superficie espacial suave con coordenadas y altitud<br/><code>modelo9 <- gam(TNOV ~ s(Z_FIN) + s(LON, LAT, k = 100), ...)</code><br/><code>summary(modelo9)</code><br/><code>gam.check(modelo9)</code><br/><code>vis.gam(modelo9, view = c('LON','LAT'), plot.type = 'contour')</code>"]:::modelo
end

Paso4 --> Paso5
Paso4 --> Paso6

Paso5 --> Fin([Fin del Análisis y Evaluación de Modelos]):::inicioFin
Paso6 --> Fin
