graph TD
    %% Título principal
    CALCULO["Cálculo Diferencial de una Variable<br/><i>(Programa de Asignatura)</i>"]

    %% Bloque 1: Origen y Variación
    subgraph M1 ["1. Tasas de Cambio y Variación"]
        A["Tasa de Cambio Promedio<br/><b>Δy / Δx = [f(x₂)-f(x₁)] / [x₂-x₁]</b>"] --> B["Secante a Tangente<br/><b>Pendiente mₛₑ꜀ → mₜₐₙ</b>"]
        B --> C["Tasa de Cambio Instantánea<br/><b>lim (Δx→0) Δy/Δx</b>"]
    end

    %% Bloque 2: Límites y Continuidad
    subgraph M2 ["2. Fundamentos de Límites y Continuidad"]
        D["Concepto de Límite<br/><b>lim (x→c) f(x) = L</b>"] --> E["Límites Laterales y Existencia<br/><b>lim (x→c⁻) = lim (x→c⁺)</b>"]
        E --> F["Indeterminaciones y Continuidad<br/><b>Formas 0/0, ∞/∞ y Saltos</b>"]
    end

    %% Bloque 3: Definición de la Derivada
    subgraph M3 ["3. Definición Operativa de la Derivada"]
        G["Cociente Diferencial<br/><b>f'(x) = lim (h→0) [f(x+h)-f(x)]/h</b>"] --> H["Interpretación Geométrica<br/><b>Pendiente de la Recta Tangente</b>"]
        H --> I["Diferenciabilidad y Suavidad<br/><b>f'(x) existe ⟹ f es continua</b>"]
    end

    %% Bloque 4: Reglas de Derivación
    subgraph M4 ["4. Reglas Operativas de Derivación"]
        J["Reglas Básicas y Potencias<br/><b>d/dx[xⁿ] = n xⁿ⁻¹</b>"] --> K["Reglas de Producto y Cociente<br/><b>(u·v)' = u'v + uv'  |  (u/v)'</b>"]
        K --> L["Regla de la Cadena<br/><b>(f ∘ g)'(x) = f'(g(x))·g'(x)</b>"]
    end

    %% Bloque 5: Trascendentes, Implícita y Orden Superior
    subgraph M5 ["5. Funciones Trascendentes y Derivación Implícita"]
        M["Trigonométricas, Exp. y Log.<br/><b>(sin x)' = cos x  |  (eˣ)' = eˣ</b>"] --> N["Derivación Implícita<br/><b>d/dx[F(x,y) = 0] ⟹ dy/dx</b>"]
        N --> O["Derivadas de Orden Superior<br/><b>f''(x) = d²y/dx² (Aceleración)</b>"]
    end

    %% Bloque 6: Aplicaciones y Optimización
    subgraph M6 ["6. Análisis de Funciones y Optimización"]
        P["Monotonía y Extremos Relativos<br/><b>Criterio de la 1ª Derivada</b>"] --> Q["Concavidad y Puntos de Inflexión<br/><b>Criterio de la 2ª Derivada</b>"]
        Q --> R["Optimización y Razón de Cambio<br/><b>Máximos, Mínimos y Tasas Relacionadas</b>"]
    end

    %% Conexiones jerárquicas y secuencia pedagógica
    CALCULO --> M1
    M1 --> M2
    M2 --> M3
    M3 --> M4
    M4 --> M5
    M5 --> M6
